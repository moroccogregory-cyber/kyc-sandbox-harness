# Optional basic auth for the UI/API (leave empty = open, only for a throwaway harness)
HARNESS_USER=
HARNESS_PASS=

# Onfido / Entrust — SANDBOX token only (prefix api_sandbox)
ONFIDO_API_TOKEN=
ONFIDO_REGION=eu

# Persona — sandbox API key + a sandbox inquiry template id
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=

# Veriff — test-integration credentials
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_CALLBACK=

# Harness shows the last 50 sandbox responses in memory; nothing is persisted.
